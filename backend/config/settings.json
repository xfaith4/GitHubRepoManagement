{
  "docReview": {
    "generateQueue": true,
    "maxDepth": 3,
    "generateBatchPlan": true
  },
  "schemaVersion": "v1",
  "secrets": {
    "gitHubTokenEnvVar": "GITHUB_TOKEN"
  },
  "inventory": {
    "maxDepth": 3,
    "localRoots": [
      "F:\\Development\\20_Staging"
    ],
    "includeNonGitFolders": false
  },
  "retention": {
    "days": 30,
    "maxSnapshotDays": 365,
    "ledgers": {
      "enabled": true,
      "keepDays": 90,
      "minKeepLines": 500,
      "archiveDir": "output\\archive\\ledgers"
    }
  },
  "performance": {
    "readPathBudgetMs": {
      "memory": 2000,
      "portfolio-index": 3000,
      "assessment-cache": 3000,
      "fresh-scan": 300000
    }
  },
  "reconcile": {
    "ownerType": "Auto",
    "retry": {
      "maxAttempts": 3,
      "maxDelayMs": 2000,
      "baseDelayMs": 300
    },
    "gitHubOwner": "xfaith4"
  }
}
