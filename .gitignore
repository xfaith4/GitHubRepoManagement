# OS / Editor
.DS_Store
Thumbs.db
.vscode/
backend/config/settings.json

# TLS certificates and keys (secrets — never commit)
*.pfx
*.cer
backend/config/tls/

# PowerShell / logs / temp
*.log
*.tmp

# Frontend build and dependency artifacts
/node_modules/
frontend/node_modules/
frontend/dist/

# Generated documentation exports
*.pdf
docs/*.html

# Backend runtime/build artifacts
backend/modules/output/**
!backend/modules/output/**/
!backend/modules/output/**/.gitkeep
/logs/

# Generated adapter output
/output/**
!/output/**/
!/output/**/.gitkeep
# The !/output/**/ rule above re-includes every directory so .gitkeep survives,
# which also left smoke fixtures showing as untracked. Those fixtures contain
# nested .git directories, so `git add -A` errors out ("does not have a commit
# checked out") or, worse, stages a fixture repo. Re-ignore them outright.
/output/smoke/

# Generated evidence
/evidence/**
!/evidence/**/
!/evidence/**/.gitkeep

# Agent worklogs at the repository root. The 2026-07-15 cleanup archived these
# to docs/history/worklogs/ and they re-accrued within three weeks, so the
# convention is enforced rather than restated: keep worklogs under
# docs/history/worklogs/<date>-<topic>/ (see that directory's README), and a
# module-smoke tripwire fails if one is tracked at the root again.
/findings.md
/progress.md
/task_plan.md

# Saved reports
/reports/**
!/reports/**/
!/reports/**/.gitkeep
