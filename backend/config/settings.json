{
  "inventory": {
    "includeNonGitFolders": false,
    "localRoots": [
      "F:\\Development\\20_Staging"
    ],
    "maxDepth": 3
  },
  "retention": {
    "days": 30
  },
  "docReview": {
    "generateBatchPlan": true,
    "generateQueue": true,
    "maxDepth": 3
  },
  "secrets": {
    "gitHubTokenEnvVar": "GITHUB_TOKEN"
  },
  "schemaVersion": "v1",
  "reconcile": {
    "retry": {
      "maxDelayMs": 2000,
      "maxAttempts": 3,
      "baseDelayMs": 300
    },
    "ownerType": "Auto",
    "gitHubOwner": "xfaith4"
  }
}

