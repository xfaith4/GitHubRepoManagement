{
  "retention": {
    "days": 30
  },
  "inventory": {
    "localRoots": [
      "F:\\Development\\20_Staging"
    ],
    "maxDepth": 3,
    "includeNonGitFolders": false
  },
  "schemaVersion": "v1",
  "docReview": {
    "maxDepth": 3,
    "generateQueue": true,
    "generateBatchPlan": true
  },
  "reconcile": {
    "gitHubOwner": "xfaith4",
    "retry": {
      "maxAttempts": 3,
      "maxDelayMs": 2000,
      "baseDelayMs": 300
    },
    "ownerType": "Auto"
  },
  "secrets": {
    "gitHubTokenEnvVar": "GITHUB_TOKEN"
  }
}
