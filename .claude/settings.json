{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "pwsh -NoProfile -File \"$env:CLAUDE_PROJECT_DIR/tools/Get-SessionBriefing.ps1\"",
            "timeout": 60,
            "statusMessage": "Reading the session briefing and handoff"
          }
        ]
      }
    ]
  }
}
