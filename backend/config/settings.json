{
  "inventory": {
    "localRoots": [
      "G:\\Development\\20_Staging"
    ],
    "includeNonGitFolders": false,
    "maxDepth": 3
  },
  "retention": {
    "days": 30
  },
  "docReview": {
    "generateBatchPlan": true,
    "generateQueue": true,
    "maxDepth": 3
  },
  "schemaVersion": "v1",
  "reconcile": {
    "gitHubOwner": "xfaith4",
    "ownerType": "Auto",
    "retry": {
      "baseDelayMs": 300,
      "maxAttempts": 3,
      "maxDelayMs": 2000
    }
  },
  "secrets": {
    "gitHubTokenEnvVar": "GITHUB_TOKEN"
  }
}
