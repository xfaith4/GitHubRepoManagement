{
  "schemaVersion": "v1",
  "providers": {
    "claude": {
      "supported": true,
      "executionMode": "local",
      "providerTool": "claude-code",
      "autoPush": true,
      "maxConcurrentExecutions": 1,
      "windows": [
        {
          "name": "short-term",
          "unit": "provider-allowance"
        },
        {
          "name": "weekly",
          "unit": "provider-allowance"
        }
      ],
      "limitSignals": [
        "(?i)usage limit",
        "(?i)rate limit",
        "(?i)429"
      ],
      "provisional": true
    },
    "codex": {
      "supported": true,
      "executionMode": "local",
      "providerTool": "codex-cli",
      "autoPush": true,
      "maxConcurrentExecutions": 1,
      "windows": [
        {
          "name": "short-term",
          "unit": "provider-allowance"
        },
        {
          "name": "weekly",
          "unit": "provider-allowance"
        }
      ],
      "limitSignals": [
        "(?i)usage limit",
        "(?i)rate limit",
        "(?i)429"
      ],
      "provisional": true
    },
    "copilot": {
      "supported": true,
      "executionMode": "github-hosted",
      "providerTool": "github-copilot-agent",
      "autoPush": false,
      "maxConcurrentExecutions": 2,
      "windows": [
        {
          "name": "billing",
          "unit": "unknown"
        }
      ],
      "limitSignals": [],
      "provisional": true
    }
  },
  "reserves": {
    "shortWindowRatio": 0.15,
    "weeklyRatio": 0.2,
    "remediationInsideWeekly": true
  },
  "estimates": {
    "defaultTaskConsumptionRatio": 0.05,
    "provisional": true
  },
  "ranking": {
    "weights": {
      "suitability": 1,
      "usableCapacity": 1,
      "history": 1,
      "fitsWindow": 1,
      "sessionReuse": 1,
      "timeToReset": 1,
      "estimatedConsumption": -1,
      "recentFailureRate": -1
    },
    "tieBreak": "nearest-reset-first"
  },
  "remediation": {
    "maxRemediationAttempts": 2
  },
  "review": {
    "mediumRiskDiffLines": 200,
    "provisional": true
  },
  "defaultScope": {
    "allowedPaths": [
      "**"
    ],
    "forbiddenPaths": [
      ".github/workflows/**"
    ],
    "provisional": true
  },
  "defaultPermissions": {
    "filesystemWrite": true,
    "shell": true,
    "network": false,
    "githubWrite": false,
    "provisional": true
  },
  "dispatch": {
    "defaultTarget": "auto",
    "autoEnabled": true
  },
  "localExecutionSlots": 1
}
