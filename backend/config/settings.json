{
  "inventory": {
    "localRoots": [
      "F:\\Development\\GitHubRepoManagement\\output\\smoke\\api-host\\portfolio-fixture-repos"
    ],
    "includeNonGitFolders": false,
    "maxDepth": 3
  },
  "docReview": {
    "generateQueue": true,
    "maxDepth": 3,
    "generateBatchPlan": true
  },
  "performance": {
    "readPathBudgetMs": {
      "fresh-scan": 300000,
      "portfolio-index": 3000,
      "assessment-cache": 3000,
      "memory": 2000
    }
  },
  "schemaVersion": "v1",
  "reconcile": {
    "gitHubOwner": "xfaith4",
    "retry": {
      "baseDelayMs": 300,
      "maxDelayMs": 2000,
      "maxAttempts": 3
    },
    "ownerType": "Auto"
  },
  "secrets": {
    "gitHubTokenEnvVar": "GITHUB_TOKEN"
  },
  "retention": {
    "ledgers": {
      "enabled": true,
      "archiveDir": "output\\archive\\ledgers",
      "minKeepLines": 500,
      "keepDays": 90
    },
    "days": 30,
    "maxSnapshotDays": 365
  }
}
